# --- Local development (XAMPP) ---
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=daily_task_tracker

# Change this to any long random string (32+ characters)
JWT_SECRET=change_this_to_a_long_random_secret

# --- Only when hosting (set these in your host's dashboard, not in a file) ---
# NODE_ENV=production
# DB_SSL=true            # cloud MySQL providers require TLS
# DB_SSL_CA=...          # the provider's CA certificate text (e.g. Aiven), if it asks for one
# TZ=Asia/Kolkata        # your timezone, so "today" rolls over at your midnight
