# Copy this file to ".env.cloud" (same folder) and fill in your cloud database details.
# Used only by: node scripts/setup-db.js     (.env.cloud is never committed to GitHub)

DB_HOST=mysql-xxxx-yourproject.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=paste-your-aiven-password
DB_NAME=defaultdb

# Full path to the ca.pem you downloaded from the Aiven Overview page
DB_SSL_CA_FILE=C:\aiven\ca.pem
